# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/ebook_platform

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=token

# Client (for CORS)
CLIENT_URL=http://localhost:5173

# Google Sign-In (added on request, outside the original SRS scope).
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials — add
# http://localhost:5173 under "Authorized JavaScript origins".
# This value is not secret; it's the same one used in client/.env.
GOOGLE_CLIENT_ID=

# Uploads (Phase 1 uses local disk for avatars; Phase 3 extends the same
# swappable storage interface for eBook files/covers — still local disk
# for now, designed so a real cloud adapter can be dropped in later
# without touching calling code)
MAX_AVATAR_SIZE_MB=2
MAX_COVER_SIZE_MB=3
MAX_EBOOK_SIZE_MB=50

# Password reset email (optional — added on request, outside the original
# SRS scope). If these are left blank, "forgot password" still works in
# development: the reset link is printed in the server console and shown
# on the page instead of being emailed. Fill in real SMTP details to send
# actual emails (e.g. Gmail: smtp.gmail.com, port 587, and an app password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
